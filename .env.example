# ---------------------------------------------------------------------------
# Copy this file to .env for local development (`docker run --env-file .env`).
# On Heroku, set these as Config Vars instead (dashboard or `heroku config:set`).
# ---------------------------------------------------------------------------

# --- HTTP server ---
# HOST=0.0.0.0
# On Heroku, PORT is injected automatically — do not set it manually.
# PORT=5000
# CORS_ORIGIN=*

# --- TeraBox session ---
# JSON object of cookies from a logged-in TeraBox web session, e.g.
# {"ndus":"...","BDUSS":"..."}
TERABOX_COOKIES_JSON=

# --- Telegram bot (required to enable the bot) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
TELEGRAM_ALLOWED_USER_IDS=
# Set to true instead of TELEGRAM_ALLOWED_USER_IDS to allow anyone to use the bot.
# TELEGRAM_ALLOW_PUBLIC=false

# --- Optional: raw MTProto large-file transfer worker ---
# Requires TELEGRAM_BOT_TOKEN to be set. Get API_ID / API_HASH from https://my.telegram.org
# TELEGRAM_UPLOAD_ENABLED=false
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# --- Optional: protected /admin dashboard ---
# Must be at least 16 non-space characters.
# ADMIN_API_KEY=

# --- Optional tuning (defaults shown) ---
# CACHE_TTL_SECONDS=7200
# CACHE_MAX_ITEMS=500
# TERABOX_REQUEST_TIMEOUT_MS=20000
# TELEGRAM_POLL_TIMEOUT_SECONDS=25
# TELEGRAM_REQUEST_TIMEOUT_MS=40000
# TELEGRAM_MAX_FILES_PER_REPLY=5
# TRANSFER_UPLOAD_LIMIT_MB=1900
# TRANSFER_SPLIT_PART_MB=1800
# TRANSFER_TEMP_DIR=/tmp/terabox-transfers
# TRANSFER_DATABASE_PATH=
# TRANSFER_ZIP_COMMAND=zip
# TRANSFER_MEDIA_MODE=auto
# TRANSFER_MAX_SOURCE_GB=20
# TRANSFER_DISK_SAFETY_MB=1024
# TRANSFER_QUEUE_CONCURRENCY=1
# TRANSFER_MAX_QUEUE=3
# TRANSFER_UPLOAD_WORKERS=4
# TRANSFER_PROGRESS_INTERVAL_SECONDS=5
# TRANSFER_SPLIT_OVERSIZE=true
# TRANSFER_MAX_ATTEMPTS=3
# TRANSFER_RETRY_BASE_SECONDS=30
# TRANSFER_JOB_HISTORY_LIMIT=100
# TRANSFER_MAX_JOBS_PER_USER_PER_DAY=20
# TRANSFER_DOWNLOAD_CHUNKS=8
